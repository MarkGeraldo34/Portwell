# Network the app talks to: "testnet" or "mainnet"
NEXT_PUBLIC_NEAR_NETWORK=testnet
# Account the escrow contract is deployed to
NEXT_PUBLIC_CONTRACT_ID=

# REQUIRED for posting. Server-side only (never prefix with NEXT_PUBLIC). The AI scam review is mandatory:
# without a key, requests, offers and sharer posts cannot be published. Get a key at https://cloud.near.ai.
NEAR_AI_API_KEY=
