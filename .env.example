# Network the app talks to: "testnet" or "mainnet"
NEXT_PUBLIC_NEAR_NETWORK=testnet
# Account the escrow contract is deployed to
NEXT_PUBLIC_CONTRACT_ID=portwell.testnet

# Optional. Server-side only (never prefix with NEXT_PUBLIC). Enables the AI review layer.
# Get a key at https://cloud.near.ai. Without it, only the rules-based scanner runs.
NEAR_AI_API_KEY=
# NEAR_AI_MODEL=zai-org/GLM-5.1-FP8
